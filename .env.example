# ─────────────────────────────────────────────────────────────────────────────
# Multi-Persona Code Reviewer — environment configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Your LLM API key (IBM watsonx IAM token, OpenAI key, etc.)
LLM_API_KEY=your-api-key-here

# Base URL of the OpenAI-compatible chat-completions endpoint.
# Default targets IBM watsonx.ai (us-south region).
# For OpenAI-compatible servers use: https://api.openai.com/v1/chat/completions
LLM_BASE_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/chat

# Model identifier passed in every request payload.
LLM_MODEL=ibm/granite-3-8b-instruct
