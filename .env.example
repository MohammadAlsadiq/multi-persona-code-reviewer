# ─────────────────────────────────────────────────────────────────────────────
# Multi-Persona Code Reviewer — environment configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Your LLM API key.
# - Gemini (current dev target): get one free at https://aistudio.google.com/apikey
# - IBM watsonx / any other OpenAI-compatible provider: use that provider's key.
LLM_API_KEY=your-api-key-here

# Base URL of the OpenAI-compatible chat-completions endpoint.
# Default below targets Gemini's OpenAI-compatibility layer.
# For IBM watsonx.ai use:  https://us-south.ml.cloud.ibm.com/ml/v1/text/chat
# For OpenAI itself use:   https://api.openai.com/v1/chat/completions
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Model identifier passed in every request payload.
# Gemini: gemini-2.5-flash | watsonx: ibm/granite-3-8b-instruct
LLM_MODEL=gemini-2.5-flash
